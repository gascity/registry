            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "packPath": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "requestedName": {
            "type": "string"
          },
          "requestedVersion": {
            "type": "string"
          },
          "requestedDescription": {
            "type": "string"
          },
          "registryEntry": {
            "$ref": "#/components/schemas/PublishRegistryEntry"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
