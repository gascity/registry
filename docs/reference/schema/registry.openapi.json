          },
          "packPath": {
            "type": "string"
          },
          "requestedName": {
            "type": "string"
          },
          "requestedVersion": {
            "type": "string"
          },
          "requestedRef": {
            "type": "string"
          },
          "requestedDescription": {
            "type": "string"
          }
