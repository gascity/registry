              },
              "recommendCount": {
                "type": "integer"
              }
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewRow"
            }
          },
          "viewerReview": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReviewRow"
              }
            ],
            "nullable": true
          },
          "viewerHasStarred": {
            "type": "boolean"
          }
        }
      },
      "DeviceCodeResponse": {
        "type": "object",
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ],
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string"
          },
          "verification_uri_complete": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "interval": {
            "type": "integer"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "scope"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "bearer"
            ]
          },
          "scope": {
            "type": "string"
          },
          "registry_url": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "required": [
