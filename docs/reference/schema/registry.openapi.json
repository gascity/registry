  "components": {
    "securitySchemes": {
      "gcrToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gcr_",
        "description": "Registry API key (prefix gcr_)."
      },
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "registry_session",
        "description": "First-party browser session."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "CSRF token (AND-composed with cookieSession + same-origin on mutations)."
      },
      "githubActionsOidc": {
        "type": "http",
        "scheme": "bearer",
        "description": "GitHub Actions OIDC JWT (audience gascity-registry) in the request body; mints a short-lived gcr_ publish token."
      },
      "githubWebhook": {
        "type": "apiKey",
        "in": "header",
        "name": "x-hub-signature-256",
        "description": "GitHub webhook HMAC signature."
      }
    },
    "schemas": {
      "PublicUser": {
        "type": "object",
        "required": [
          "id",
          "handle",
          "displayName",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "moderator",
              "user"
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "authConfigured",
          "devAuthEnabled",
          "store"
        ],
        "properties": {
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicUser"
              }
            ],
            "nullable": true
          },
          "csrfToken": {
            "type": "string",
            "nullable": true
          },
          "authConfigured": {
            "type": "boolean"
          },
          "authProvider": {
            "type": "string",
            "nullable": true
          },
          "devAuthEnabled": {
            "type": "boolean"
          },
          "store": {
            "type": "string",
            "enum": [
              "file",
              "postgres"
            ]
          }
        }
      },
      "PublishRegistryRelease": {
        "type": "object",
        "required": [
          "version",
          "ref",
          "commit",
          "hash",
          "description"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "PublishRegistryEntry": {
