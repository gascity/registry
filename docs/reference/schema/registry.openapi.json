          },
          "source": {
            "type": "string"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "git"
            ]
          },
          "release": {
            "$ref": "#/components/schemas/PublishRegistryRelease"
          }
        }
      },
      "PublishRequest": {
        "type": "object",
        "required": [
          "id",
          "status",
          "requestedName",
          "requestedVersion",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
