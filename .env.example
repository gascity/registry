# Local development defaults.
APP_URL=http://127.0.0.1:5173
PORT=8081
REGISTRY_API_PORT=8081
REGISTRY_DATA_PATH=.registry-data/registry.local.json
REGISTRY_DEV_AUTH=1

# Production state and sessions. Leave unset for local file-backed development.
DATABASE_URL=
SESSION_SECRET=

# Auth provider. WorkOS is used in production today; OIDC is reserved for
# auth.gascity.com federation.
REGISTRY_AUTH_PROVIDER=
WORKOS_API_BASE_URL=https://api.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GASCITY_USER_ID_CLAIM=gascity_user_id
OIDC_GASCITY_ACCOUNT_ID_CLAIM=gascity_account_id

# GitHub App ownership verification.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Optional frontend build-time catalog overrides.
VITE_CATALOG_URL=
VITE_REGISTRY_URL=
