# Local development defaults.
APP_URL=http://127.0.0.1:5173
PORT=8081
REGISTRY_API_PORT=8081
REGISTRY_DATA_PATH=.registry-data/registry.local.json
# Local-only dev sign-in backdoor (mints arbitrary roles). Ships DISABLED so copying this
# template to a deployment can never arm it. The `bun run dev*` scripts turn it on locally
# (with a loopback APP_URL). The server force-disables it in production, on a known platform
# (Railway/K8s/Fly/Render/Heroku), and on any non-loopback / all-interfaces / unset origin.
REGISTRY_DEV_AUTH=0

# Production state and sessions. Leave unset for local file-backed development.
DATABASE_URL=
SESSION_SECRET=

# Auth provider. Beta/production runs OIDC (Keycloak / auth.gascity.com federation):
# set REGISTRY_AUTH_PROVIDER=oidc with the OIDC_* values below. WorkOS remains a
# supported alternate. A provider MUST be configured in production — the server refuses
# to start without one.
REGISTRY_AUTH_PROVIDER=
WORKOS_API_BASE_URL=https://api.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GASCITY_USER_ID_CLAIM=gascity_user_id
OIDC_GASCITY_ACCOUNT_ID_CLAIM=gascity_account_id
# Gas City Keycloak only: require the signed idp_connection current-session broker claim.
# Leave false for a generic/self-hosted OIDC issuer without this realm contract.
OIDC_ENFORCE_BROKER_BOUNDARY=false

# Short-lived Gasworks STS assertions accepted for direct publishing. Configure both or neither;
# the audience is pinned in code to "registry". Registry-native gcr_ tokens remain supported.
REGISTRY_EIA_ISSUER=https://edge.gascity.internal
REGISTRY_EIA_JWKS_URL=https://works.gascity.com/sts/v0/jwks/registry

# Optional Gas City deployment seam: resolve a verified OIDC sub to the stable Accounts user_id
# so browser/device credentials and STS EIAs converge on one Registry principal. Both values are
# required together. The bearer gates only /v0/resolve/registry-user. An explicit Accounts "user
# not found" preserves native-only Registry users. If proxy env vars exist, set effective no_proxy=*.
REGISTRY_ACCOUNTS_BASE_URL=
REGISTRY_ACCOUNTS_RESOLVER_TOKEN=
REGISTRY_ACCOUNTS_RESOLVE_TIMEOUT_MS=3000

# GitHub App ownership verification.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Direct publish validation. Local dev uses `gc` from PATH.
REGISTRY_GC_BIN=gc
REGISTRY_PUBLISH_VALIDATION_TIMEOUT_MS=120000

# Optional frontend build-time catalog overrides.
VITE_CATALOG_URL=
VITE_REGISTRY_URL=
