{
  "name": "registry",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run generate && bun scripts/dev.ts",
    "dev:vite": "vite",
    "dev:api": "REGISTRY_DEV_AUTH=1 PORT=8081 APP_URL=http://127.0.0.1:8081 bun server/index.ts",
    "dev:static": "bun run generate && bun run build && REGISTRY_DEV_AUTH=1 APP_URL=http://127.0.0.1:8080 bun server/index.ts",
    "dev:harness": "bun run generate && bun run build && REGISTRY_HARNESS=1 REGISTRY_DEV_AUTH=1 bun server/index.harness.ts",
    "generate": "bun scripts/generate-registry.ts",
    "generate:check": "bun scripts/generate-registry.ts --check",
    "build": "tsc -b && vite build",
    "serve": "bun server/index.ts",
    "preview": "vite preview",
    "test:unit": "bun test server/*.test.ts scripts/*.test.ts",
    "test:e2e": "playwright test",
    "test:cli": "bun test e2e/cli-publish.test.ts",
    "typecheck": "tsc -b --pretty false",
    "openapi:gen": "openapi-typescript docs/reference/schema/registry.openapi.json -o server/openapi.gen.ts",
    "openapi:check": "bun run openapi:gen && git diff --exit-code -- server/openapi.gen.ts docs/reference/schema/registry.openapi.json"
  },
  "dependencies": {
    "@openpanel/web": "1.4.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.6.1",
    "@gascity/tokens": "^0.4.1",
    "@gascity/ui": "^0.7.2",
    "@gascity/shell": "^0.9.3",
    "@gascity/auth": "^0.1.6",
    "@gascity/panel-sdk": "^0.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
